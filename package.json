{
  "name": "screenfling",
  "productName": "ScreenFling",
  "version": "0.0.0",
  "description": "Capture visual context and stage it in the right coding session.",
  "author": "d-sandhu",
  "private": true,
  "main": "./out/main/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-sandhu/screenfling.git"
  },
  "homepage": "https://github.com/d-sandhu/screenfling",
  "bugs": {
    "url": "https://github.com/d-sandhu/screenfling/issues"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": "11.19.0"
  },
  "scripts": {
    "start": "npm run build:native && npm run electron:install && electron-vite dev",
    "electron:install": "install-electron --no",
    "build:native": "node tools/build-native.cjs",
    "build": "npm run build:native && electron-vite build",
    "package": "node tools/package.cjs",
    "package:mac": "npm run build && electron-builder --publish never --dir --mac --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "package:win": "npm run build && electron-builder --publish never --dir --win --x64",
    "make": "npm run build && electron-builder --publish never",
    "acceptance:capture": "node tools/acceptance/capture.cjs",
    "acceptance:capture:package": "npm run package && npm run acceptance:capture",
    "lint": "oxlint --type-aware",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"src/**/*.{ts,tsx,css,html}\" \"tools/**/*.cjs\" \"*.{json,ts,mts}\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"src/**/*.{ts,tsx,css,html}\" \"tools/**/*.cjs\" \"*.{json,ts,mts}\"",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:native",
    "test": "vitest run && node --test tools/acceptance/capture.test.cjs tools/release-macos.test.cjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:all": "npm run check && npm run package",
    "release:mac": "node tools/release-macos.cjs"
  },
  "build": {
    "appId": "com.dsandhu.screenfling",
    "productName": "ScreenFling",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/native/**/*",
      "package.json"
    ],
    "afterPack": "tools/after-pack.cjs",
    "mac": {
      "extendInfo": {
        "NSAudioCaptureUsageDescription": null,
        "NSBluetoothAlwaysUsageDescription": null,
        "NSBluetoothPeripheralUsageDescription": null,
        "NSCameraUsageDescription": null,
        "NSMicrophoneUsageDescription": null
      },
      "extraResources": [
        {
          "from": "out/native/screenfling-selector-acl",
          "to": "screenfling-selector-acl"
        }
      ],
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "bundleShortVersion": "0.1.0",
      "bundleVersion": "1"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "extraMetadata": {
      "version": "0.1.0-alpha.1"
    }
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.63.0",
    "plist": "5.0.0",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "electron-winstaller": false
  }
}
